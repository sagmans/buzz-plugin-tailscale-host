#!/usr/bin/env bash
# Repository checks for the plugin and the runner, beyond the generic ones in
# .githooks/lib.
#
# Why: Buzz runs plugin.js unsandboxed inside the desktop app, and the runner
# holds agent keys and starts harnesses through sudo on a host. A syntax or
# type error, a broken manifest or install script, a behavior regression or a
# leaked private value would ship with the next install. The git hooks call
# this script (pre-commit: --quick on the staged tree; pre-push: full, on
# every pushed commit), and contributors run it by hand:
# `scripts/check` or `scripts/check --quick`.
#
# Usage: scripts/check [--quick] [DIR]
#   DIR is a tree with this repository's layout. Default: the top of the git
#   worktree that holds the working directory, else this script's checkout.
#   The pre-push hook relies on this: it runs this checkout's script inside a
#   temporary worktree of each pushed commit, and that tree is the one to judge.
#   A git worktree is judged by its tracked files only; any other directory
#   (the exported index at pre-commit) by every regular file in it.
#
# The full run needs a buzz-app clone at the pinned revision with its
# dependencies installed (see runner/README.md, Build): BUZZ_APP_DIR, else
# the clone this checkout's runner/buzz-app link points to.
#
# Every check fails closed: a missing tool, a tool error or a finding exits 1.
# A check whose input is absent from DIR (for example an older commit without
# the runner) is skipped, because there is nothing for it to judge.
set -euo pipefail

SELF_DIR="$(cd "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
REPO_TOP="$(cd "$SELF_DIR/.." && pwd -P)"
HOOK_LIB="$REPO_TOP/.githooks/lib"
# shellcheck source-path=SCRIPTDIR source=../.githooks/lib/tools.sh
. "$HOOK_LIB/tools.sh"

CHECK=repo-check
PLUGIN_DIR=plugin
MANIFEST="$PLUGIN_DIR/manifest.json"
PLUGIN_JS="$PLUGIN_DIR/plugin.js"
HOSTS_EXAMPLE=hosts.example.json
BUILD_PLUGIN=scripts/build-plugin.mjs
BUILD_RUNNER=scripts/build-runner.mjs
LINK_TOOLCHAIN=scripts/link-toolchain
RUNNER_DIR=runner
RUNNER_SMOKE="$RUNNER_DIR/smoke/run.mjs"
RUNNER_BUNDLE_NAME=buzz-runner.mjs
INSTALL_SH="$RUNNER_DIR/deploy/install.sh"
CONFIG_EXAMPLE="$RUNNER_DIR/config.example.json"
TOOLCHAIN_LINK="$RUNNER_DIR/buzz-app"
RUNNER_LOCKFILE="$RUNNER_DIR/pnpm-lock.yaml"
# Buzz manifest limits (buzz-app crates/plugin-manager): id shape and length,
# description size in bytes.
MANIFEST_ID_RE='^[a-z][a-z0-9.-]{0,79}$'
MANIFEST_DESCRIPTION_MAX_BYTES=280
MANIFEST_API_VERSION=1
# Complexity limits match the generic changed-function check, applied here
# to every function so old code cannot drift past them unnoticed.
LIZARD_MAX_CCN=15
LIZARD_MAX_LENGTH=100
# Network scanners and the smoke run must not freeze a push.
SEMGREP_TIMEOUT_SECONDS=300
TRIVY_TIMEOUT_SECONDS=300
SMOKE_TIMEOUT_SECONDS=600
# The runner install may fetch packages missing from the local pnpm store.
PNPM_INSTALL_TIMEOUT_SECONDS=300
SEMGREP_REGISTRY_CONFIG=p/javascript
# Minimum versions: the releases these flags and rule sets were verified with.
NODE_MIN_VERSION=24.0.0
# The release the runner lockfile was made with. Older pnpm reads the minimum
# release age settings differently. No packageManager field pins it: pnpm 12
# then writes a second YAML document into the lockfile, and osv-scanner reads
# only the first, so the dependency scan would miss every runner package.
PNPM_MIN_VERSION=12.4.2
SHELLCHECK_MIN_VERSION=0.10.0
SHFMT_MIN_VERSION=3.8.0
MARKDOWNLINT_MIN_VERSION=0.23.2
LIZARD_MIN_VERSION=1.24.1
SEMGREP_MIN_VERSION=1.182.0
TRIVY_MIN_VERSION=0.60.0
# Generic shapes of private data that must never reach a public repository.
# Real names and handles are deliberately not listed: the guard itself is
# public. Bracketed first letters keep each pattern from matching its own
# source text.
PRIVATE_PATTERNS=(
	'\.tail[0-9a-f]+\.ts\.net'
	'/[U]sers/[^/[:space:]]+/'
	'/[h]ome/[^/[:space:]]+/'
	'[~]/\.buzz'
	'[~]/[s]ource/'
	'npub1[02-9ac-hj-np-z]{20,}'
	'nsec1[02-9ac-hj-np-z]{20,}'
	'(^|[^0-9a-f])[0-9a-f]{64}([^0-9a-f]|$)'
	'[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}'
	'[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}'
)
# Matches that are public by design, judged per match (not per line):
# RFC 2606 example domains, GitHub's shared SSH user, the documented harness
# user's home, and all-zero placeholder keys and ids.
PRIVATE_ALLOWED_RE='@example\.(com|org|net|invalid)|^git@github\.com$|^/home/buzz-agent/$|(^|[^0-9a-f])0{64}([^0-9a-f]|$)|^00000000-0000-4000-8000-000000000000$'
# Files copied from the hook template stay byte-identical to it, so their
# style is the template's concern; repo-owned shell lives elsewhere.
TEMPLATE_SHELL_RE='^(\.githooks/[^/]+|\.githooks/lib/.*|scripts/setup-hooks)$'

quick=0
if [ "${1:-}" = --quick ]; then
	quick=1
	shift
fi
default_target="$(git rev-parse --show-toplevel 2>/dev/null || printf '%s' "$REPO_TOP")"
target="$(cd "${1:-$default_target}" && pwd -P)"
cd "$target"

tmp="$(mktemp -d "${TMPDIR:-/tmp}/repo-check.XXXXXX")"
# Only the mktemp directory this run created, never a computed parent.
cleanup() {
	case "$tmp" in
	*/repo-check.*) rm -rf -- "$tmp" ;;
	esac
}
trap cleanup EXIT

fail() {
	echo >&2 "❌ $CHECK: $*"
	exit 1
}

# Print the files to judge, NUL-separated, relative to the target.
list_files() {
	if [ "$(git rev-parse --show-toplevel 2>/dev/null || true)" = "$target" ]; then
		git ls-files -z
	else
		find . -type f -not -path './runner/buzz-app/*' -not -path './runner/node_modules/*' -print0
	fi
}

files=()
while IFS= read -r -d '' path; do
	files+=("${path#./}")
done < <(list_files)

has_file() {
	local want="$1" path
	for path in "${files[@]}"; do
		[ "$path" = "$want" ] && return 0
	done
	return 1
}

# Print the tracked files with one of the given extensions, one per line.
files_with() {
	local path ext
	for path in "${files[@]}"; do
		for ext in "$@"; do
			case "$path" in *."$ext") printf '%s\n' "$path" ;; esac
		done
	done
}

require_node() {
	require_tool "$CHECK" node "$NODE_MIN_VERSION" 'install Node.js 24 or newer (https://nodejs.org)' node --version
}

# Every JS file must parse, so neither the Buzz loader nor the host meets a
# syntax error that a reviewer missed. TypeScript is judged by the type check.
check_js_syntax() {
	local path list
	list="$(files_with js mjs cjs)"
	[ -n "$list" ] || return 0
	require_node
	while IFS= read -r path; do
		node --check "$path" || fail "node --check failed: $path"
	done <<<"$list"
}

# Every JSON file must parse: configs and manifests are read without a
# second chance on the host and in the app.
check_json() {
	local list
	list="$(files_with json)"
	[ -n "$list" ] || return 0
	require_node
	# shellcheck disable=SC2016,SC2086  # JS template literal, not shell; one path per word (spaces refused below)
	node -e 'for (const p of process.argv.slice(1)) { try { JSON.parse(require("fs").readFileSync(p, "utf8")); } catch (e) { console.error(`  ${p}: ${e.message}`); process.exitCode = 1; } }' $list ||
		fail "invalid JSON"
}

# Buzz rejects the whole install for a bad manifest. The source manifest has
# no host block: the build writes it from the user's hosts.json.
check_manifest() {
	has_file "$MANIFEST" || return 0
	has_file "$PLUGIN_JS" || fail "$MANIFEST exists but $PLUGIN_JS is missing"
	require_node
	node --input-type=module - "$MANIFEST" "$MANIFEST_ID_RE" "$MANIFEST_DESCRIPTION_MAX_BYTES" "$MANIFEST_API_VERSION" <<'NODE' || fail "$MANIFEST is invalid"
import { readFileSync } from "node:fs";
const [path, idPattern, maxBytes, apiVersion] = process.argv.slice(2);
const manifest = JSON.parse(readFileSync(path, "utf8"));
const problems = [];
if (!new RegExp(idPattern).test(manifest.id ?? "")) problems.push(`id ${JSON.stringify(manifest.id)} does not match ${idPattern}`);
if (typeof manifest.name !== "string" || !manifest.name.trim()) problems.push("name is empty");
if (manifest.apiVersion !== Number(apiVersion)) problems.push(`apiVersion is not ${apiVersion}`);
const bytes = Buffer.byteLength(manifest.description ?? "", "utf8");
if (bytes < 1 || bytes > Number(maxBytes)) problems.push(`description is ${bytes} bytes (1-${maxBytes})`);
if (manifest.host !== undefined) problems.push("the source manifest must not declare host: scripts/build-plugin.mjs writes it from hosts.json");
for (const problem of problems) console.error(`  ${path}: ${problem}`);
process.exit(problems.length ? 1 : 0);
NODE
}

# The installable plugin is a build output; the example host list must build,
# and the built manifest must grant exactly the example's origins.
check_plugin_build() {
	has_file "$BUILD_PLUGIN" || return 0
	has_file "$HOSTS_EXAMPLE" || fail "$BUILD_PLUGIN exists but $HOSTS_EXAMPLE is missing"
	require_node
	node "$BUILD_PLUGIN" --hosts "$HOSTS_EXAMPLE" --out "$tmp/plugin" >/dev/null || fail "the plugin does not build from $HOSTS_EXAMPLE"
	node --input-type=module - "$HOSTS_EXAMPLE" "$tmp/plugin/manifest.json" <<'NODE' || fail "the built manifest does not grant exactly the example origins"
import { readFileSync } from "node:fs";
const [hostsPath, manifestPath] = process.argv.slice(2);
const want = JSON.parse(readFileSync(hostsPath, "utf8")).hosts.map((host) => host.origin);
const got = JSON.parse(readFileSync(manifestPath, "utf8")).host?.networkOrigins ?? [];
process.exit(JSON.stringify(want) === JSON.stringify(got) ? 0 : 1);
NODE
}

# Repo-owned shell scripts: lint for bugs, and one format so diffs stay small.
check_shell() {
	local path shells=() first
	for path in "${files[@]}"; do
		[[ "$path" =~ $TEMPLATE_SHELL_RE ]] && continue
		first=''
		IFS= read -r first <"$path" || true
		case "$path:$first" in *.sh:* | *':#!'*sh) shells+=("$path") ;; esac
	done
	[ "${#shells[@]}" -gt 0 ] || return 0
	require_tool "$CHECK" shellcheck "$SHELLCHECK_MIN_VERSION" 'install shellcheck (https://www.shellcheck.net)' shellcheck --version
	require_tool "$CHECK" shfmt "$SHFMT_MIN_VERSION" 'install shfmt (https://github.com/mvdan/sh)' shfmt --version
	shellcheck --external-sources --severity=style "${shells[@]}" || fail "shellcheck found problems"
	shfmt --diff "${shells[@]}" || fail "shfmt would reformat these files; run: shfmt --write <file>"
}

# The install script must plan a full install from the example values
# without root, so a broken render or a missing file shows before a host.
check_install_dry_run() {
	has_file "$INSTALL_SH" || return 0
	local bundle="$tmp/install/$RUNNER_BUNDLE_NAME" config="$tmp/install/config.json"
	mkdir -p "$tmp/install"
	: >"$bundle"
	# The example ships a placeholder owner, which install.sh refuses; a
	# real-looking owner shows that only the placeholder is refused.
	node -e 'const c = JSON.parse(require("fs").readFileSync(process.argv[1], "utf8")); c.ownerPubkey = "ab".repeat(32); process.stdout.write(JSON.stringify(c));' "$CONFIG_EXAMPLE" >"$config"
	NODE_BIN="$(command -v node)" "$INSTALL_SH" --dry-run --bundle "$bundle" --config "$config" >/dev/null ||
		fail "$INSTALL_SH --dry-run failed with the example config"
	if NODE_BIN="$(command -v node)" "$INSTALL_SH" --dry-run --bundle "$bundle" --config "$CONFIG_EXAMPLE" >/dev/null 2>&1; then
		fail "$INSTALL_SH accepted the example's placeholder owner"
	fi
}

# Fail on any private-data shape; print path:line:match so it is fixed in one
# pass. Allowed public matches are filtered per match, so an allowed value on
# a line cannot hide a private one next to it.
check_private_data() {
	local pattern hits found=0
	[ "${#files[@]}" -gt 0 ] || return 0
	for pattern in "${PRIVATE_PATTERNS[@]}"; do
		hits="$(grep -n -o -I -E -- "$pattern" "${files[@]}" | awk -v allowed="$PRIVATE_ALLOWED_RE" '{
			match_text = $0
			sub(/^[^:]*:[0-9]+:/, "", match_text)
			if (match_text !~ allowed) print
		}' || true)"
		if [ -n "$hits" ]; then
			echo >&2 "❌ $CHECK: private-data pattern '$pattern' matched:"
			printf '%s\n' "$hits" | sed 's/^/   /' >&2
			found=1
		fi
	done
	[ "$found" -eq 0 ] || fail "remove the private data above (use neutral words such as \"the user\" or example.com)"
}

# The runner's own packages, exactly as its lockfile pins them: the judged
# tree is built and smoke-tested with them, never with whatever is installed.
install_runner_packages() {
	has_file "$RUNNER_LOCKFILE" || return 0
	require_tool "$CHECK" pnpm "$PNPM_MIN_VERSION" 'install pnpm (https://pnpm.io/installation)' pnpm --version
	run_with_timeout "$PNPM_INSTALL_TIMEOUT_SECONDS" pnpm --dir "$RUNNER_DIR" install --frozen-lockfile --reporter=silent ||
		fail "cannot install the runner packages from $RUNNER_LOCKFILE"
}

# The buzz-app clone the runner builds with: BUZZ_APP_DIR, else this
# checkout's link. A full check without it cannot judge the runner.
toolchain_clone() {
	if [ -n "${BUZZ_APP_DIR:-}" ]; then
		printf '%s\n' "$BUZZ_APP_DIR"
	elif [ -L "$REPO_TOP/$TOOLCHAIN_LINK" ]; then
		(cd "$REPO_TOP/$TOOLCHAIN_LINK" && pwd -P)
	else
		return 1
	fi
}

# Type check, build and the end-to-end smoke run (mock relay, fake harnesses,
# the built plugin against the live runner). The bundle goes to a temporary
# directory, so a check never replaces a contributor's runner/dist.
check_runner() {
	has_file "$RUNNER_SMOKE" || return 0
	local clone
	clone="$(toolchain_clone)" || fail "no buzz-app clone for the runner: set BUZZ_APP_DIR or run $LINK_TOOLCHAIN <clone> (runner/README.md, Build)"
	has_file "$LINK_TOOLCHAIN" || fail "$RUNNER_SMOKE exists but $LINK_TOOLCHAIN is missing"
	has_file "$BUILD_RUNNER" || fail "$RUNNER_SMOKE exists but $BUILD_RUNNER is missing"
	require_node
	if [ "$(cd "$target/$TOOLCHAIN_LINK" 2>/dev/null && pwd -P)" != "$(cd "$clone" && pwd -P)" ]; then
		"./$LINK_TOOLCHAIN" "$clone" >/dev/null || fail "cannot link the buzz-app clone $clone"
	fi
	install_runner_packages
	node "$BUILD_RUNNER" --out "$tmp/runner" || fail "the runner does not type check or build"
	BUZZ_RUNNER_BUNDLE="$tmp/runner/$RUNNER_BUNDLE_NAME" run_with_timeout "$SMOKE_TIMEOUT_SECONDS" node "$RUNNER_SMOKE" ||
		fail "runner smoke run failed"
}

# The generic hook lints only staged Markdown; at push the whole tree is judged.
check_markdown() {
	local list
	list="$(files_with md MD markdown)"
	[ -n "$list" ] || return 0
	require_tool "$CHECK" markdownlint-cli2 "$MARKDOWNLINT_MIN_VERSION" 'install markdownlint-cli2' markdownlint-cli2 --help
	# shellcheck disable=SC2086  # one path per word
	markdownlint-cli2 --config "$HOOK_LIB/markdownlint.jsonc" -- $list || fail "markdownlint found problems"
}

check_complexity() {
	local list
	list="$(files_with js mjs cjs ts)"
	[ -n "$list" ] || return 0
	require_tool "$CHECK" lizard "$LIZARD_MIN_VERSION" 'install lizard (pipx install lizard)' lizard --version
	# shellcheck disable=SC2086  # one path per word
	lizard --CCN "$LIZARD_MAX_CCN" --length "$LIZARD_MAX_LENGTH" --warnings_only $list ||
		fail "lizard: a function is above CCN $LIZARD_MAX_CCN or $LIZARD_MAX_LENGTH lines"
}

# The registry JavaScript rule set adds rules (DOM XSS, insecure randomness,
# ...) to the generic hook's vendored offline rules.
check_semgrep() {
	local list
	list="$(files_with js mjs cjs ts)"
	[ -n "$list" ] || return 0
	require_tool "$CHECK" semgrep "$SEMGREP_MIN_VERSION" 'install semgrep (https://semgrep.dev)' semgrep --version
	# shellcheck disable=SC2086  # one path per word
	run_with_timeout "$SEMGREP_TIMEOUT_SECONDS" semgrep scan --config "$SEMGREP_REGISTRY_CONFIG" \
		--metrics=off --disable-version-check --error --quiet -- $list ||
		fail "semgrep $SEMGREP_REGISTRY_CONFIG failed (finding, network error or timeout)"
}

# Second, independent secret engine next to gitleaks, plus misconfiguration
# rules for the unit, workflows or container files.
check_trivy() {
	require_tool "$CHECK" trivy "$TRIVY_MIN_VERSION" 'install trivy (https://trivy.dev)' trivy --version
	run_with_timeout "$TRIVY_TIMEOUT_SECONDS" trivy fs --quiet --scanners secret,misconfig \
		--skip-dirs .git --skip-dirs "$TOOLCHAIN_LINK" --skip-dirs "$RUNNER_DIR/node_modules" \
		--exit-code 1 --timeout "${TRIVY_TIMEOUT_SECONDS}s" . ||
		fail "trivy found secrets or misconfigurations (or failed to run)"
}

# Paths are passed word by word above; a path with a space would split.
for path in "${files[@]}"; do
	case "$path" in *[[:space:]]*) fail "path with white space is not supported: $path" ;; esac
done

check_js_syntax
check_json
check_manifest
check_shell
check_private_data
if [ "$quick" -eq 1 ]; then
	exit 0
fi
check_plugin_build
check_install_dry_run
check_markdown
check_complexity
check_semgrep
check_trivy
check_runner
echo "✅ $CHECK: all checks passed for $target"
